{
  "functions": {
    "api/client.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/mp-integration?mp_route=:path*"
    },
    {
      "source": "/api/webhooks/pancake-pos",
      "destination": "/api/mp-integration?mp_route=@webhook"
    },
    {
      "source": "/mcp",
      "destination": "/api/mp-integration?mp_route=@mcp"
    },
    {
      "source": "/client/:id",
      "destination": "/api/client?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite",
  "outputDirectory": "dist"
}
